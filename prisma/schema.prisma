// Sample.fm — Prisma schema
// Postgres-backed relational schema for the SmartLink & pre-save platform.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String      @id @default(uuid())
  email         String      @unique
  password_hash String
  is_pro        Boolean     @default(false)
  custom_domain String?
  created_at    DateTime    @default(now())
  smartlinks    SmartLink[]

  @@map("users")
}

model SmartLink {
  id             String     @id @default(uuid()) // internal id
  slug           String     @unique // public-facing unique slug, e.g. sample.fm/xyz123
  user_id        String
  user           User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  artist_name    String
  track_title    String
  release_date   DateTime
  artwork_url    String
  is_presave     Boolean    @default(false)

  url_audiomack  String?
  url_boomplay   String?
  url_spotify    String?
  url_apple      String?
  url_youtube    String?

  // Premium-only fields — sanitized/dropped server-side for free-tier users
  pixel_fb       String?
  pixel_tiktok   String?

  created_at     DateTime   @default(now())

  analytics      Analytics[]
  presaves       Presave[]

  @@map("smartlinks")
}

model Analytics {
  id               String    @id @default(uuid())
  link_id          String
  link             SmartLink @relation(fields: [link_id], references: [id], onDelete: Cascade)
  platform_clicked String
  fan_country      String?
  device_type      String?
  clicked_at       DateTime  @default(now())

  @@map("analytics")
  @@index([link_id])
}

model Presave {
  id         String    @id @default(uuid())
  link_id    String
  link       SmartLink @relation(fields: [link_id], references: [id], onDelete: Cascade)
  fan_email  String
  provider   String
  processed  Boolean   @default(false)
  created_at DateTime  @default(now())

  @@map("presaves")
  @@index([link_id])
}
