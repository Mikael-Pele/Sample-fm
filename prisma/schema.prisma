// Sample.fm — Prisma schema
// Postgres-backed relational schema for the SmartLink & pre-save platform.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String      @id @default(uuid())
  email         String      @unique
  password_hash String
  is_pro        Boolean     @default(false)
  // Billing bookkeeping — "free" | "premium".
  plan             String    @default("free")
  billing_interval String? // "monthly" | "yearly" | null (free)
  plan_expires_at  DateTime? // when the current billing period ends; null while free
  pricing_region   String? // "africa" | "global" — which price they paid, for reference
  email_verified Boolean     @default(false)
  custom_domain String?
  created_at    DateTime    @default(now())
  smartlinks    SmartLink[]

  @@map("users")
}

model SmartLink {
  id             String     @id @default(uuid()) // internal id
  slug           String     @unique // public-facing unique slug, e.g. sample.fm/xyz123
  user_id        String
  user           User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  artist_name    String
  track_title    String
  release_date   DateTime
  artwork_url    String // primary/cover image shown on the fan page
  artwork_urls   String? // comma-separated gallery of all uploaded cover images
  is_presave     Boolean    @default(false)

  url_audiomack  String?
  url_boomplay   String?
  url_spotify    String?
  url_apple      String?
  url_youtube    String?
  url_deezer      String?
  url_tidal       String?
  url_soundcloud  String?
  url_pandora     String?
  url_iheartradio String?
  url_whatsapp    String? // WhatsApp Channel link, e.g. https://whatsapp.com/channel/xxxx

  // Customizable "join the fanbase" CTA — a single, artist-branded call to
  // action (e.g. "Join the Nation") pointing wherever their community
  // actually lives (Instagram, a WhatsApp Channel, a Discord, etc).
  community_url   String?
  community_label String?

  // Premium-only fields — sanitized/dropped server-side for free-tier users
  pixel_fb       String?
  pixel_tiktok   String?

  created_at     DateTime   @default(now())

  analytics      Analytics[]
  presaves       Presave[]

  @@map("smartlinks")
}

model Analytics {
  id               String    @id @default(uuid())
  link_id          String
  link             SmartLink @relation(fields: [link_id], references: [id], onDelete: Cascade)
  platform_clicked String
  fan_country      String?
  device_type      String?
  clicked_at       DateTime  @default(now())

  @@map("analytics")
  @@index([link_id])
}

model Presave {
  id         String    @id @default(uuid())
  link_id    String
  link       SmartLink @relation(fields: [link_id], references: [id], onDelete: Cascade)
  fan_email  String
  fan_phone  String? // optional — lets creators build WhatsApp/SMS fanbases, not just email lists
  provider   String
  processed  Boolean   @default(false)
  created_at DateTime  @default(now())

  @@map("presaves")
  @@index([link_id])
}

model SupportReport {
  id         String   @id @default(uuid())
  user_id    String?
  email      String?
  message    String
  page_url   String?
  created_at DateTime @default(now())

  @@map("support_reports")
}
