// Sample.fm — Prisma schema
// Postgres-backed relational schema for the SmartLink & pre-save platform.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String      @id @default(uuid())
  email         String      @unique
  password_hash String
  is_pro        Boolean     @default(false)
  // Billing bookkeeping — "free" | "premium".
  plan             String    @default("free")
  billing_interval String? // "monthly" | "yearly" | null (free)
  plan_expires_at  DateTime? // when the current billing period ends; null while free
  pricing_region   String? // "africa" | "global" — which price they paid, for reference
  email_verified Boolean     @default(false)
  custom_domain String?
  created_at    DateTime    @default(now())
  smartlinks    SmartLink[]
  releases      Release[]
  payouts       Payout[]
  epk           EpkProfile?

  @@map("users")
}

model SmartLink {
  id             String     @id @default(uuid()) // internal id
  slug           String     @unique // public-facing unique slug, e.g. sample.fm/xyz123
  user_id        String
  user           User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  artist_name    String
  track_title    String
  release_date   DateTime
  artwork_url    String // primary/cover image shown on the fan page
  artwork_urls   String? // comma-separated gallery of all uploaded cover images
  is_presave     Boolean    @default(false)

  url_audiomack  String?
  url_boomplay   String?
  url_spotify    String?
  url_apple      String?
  url_youtube    String?
  url_deezer      String?
  url_tidal       String?
  url_soundcloud  String?
  url_pandora     String?
  url_iheartradio String?
  url_whatsapp    String? // WhatsApp Channel link, e.g. https://whatsapp.com/channel/xxxx
  url_tiktok      String? // TikTok profile or sound page

  // Auto-sourced 5-second audio preview (see lib/previewLookup.js). Both
  // null when no matching preview could be found — the fan page simply
  // shows no snippet button in that case, never a broken one.
  preview_url     String?
  preview_source  String? // "apple_music" | "deezer"

  // Customizable "join the fanbase" CTA — a single, artist-branded call to
  // action (e.g. "Join the Nation") pointing wherever their community
  // actually lives (Instagram, a WhatsApp Channel, a Discord, etc).
  community_url   String?
  community_label String?

  // "Business & Bookings" button for promoters, brands and press. Either a
  // mailto: link (when the artist entered an email) or an http(s) URL.
  booking_url     String?
  booking_label   String?

  // Premium-only fields — sanitized/dropped server-side for free-tier users
  pixel_fb       String?
  pixel_tiktok   String?

  created_at     DateTime   @default(now())

  analytics      Analytics[]
  presaves       Presave[]

  @@map("smartlinks")
}

model Analytics {
  id               String    @id @default(uuid())
  link_id          String
  link             SmartLink @relation(fields: [link_id], references: [id], onDelete: Cascade)
  platform_clicked String
  fan_country      String?
  device_type      String?
  clicked_at       DateTime  @default(now())

  @@map("analytics")
  @@index([link_id])
  // Serves the dashboard's date-ranged queries (clicks over time). Created
  // by prisma/sql/2026-10-09_analytics_link_clicked_at_index.sql.
  @@index([link_id, clicked_at])
}

model Presave {
  id         String    @id @default(uuid())
  link_id    String
  link       SmartLink @relation(fields: [link_id], references: [id], onDelete: Cascade)
  fan_email  String
  fan_phone  String? // optional — lets creators build WhatsApp/SMS fanbases, not just email lists
  provider   String
  processed  Boolean   @default(false)
  created_at DateTime  @default(now())

  @@map("presaves")
  @@index([link_id])
}

model SupportReport {
  id         String   @id @default(uuid())
  user_id    String?
  email      String?
  message    String
  page_url   String?
  created_at DateTime @default(now())

  @@map("support_reports")
}

// Artist dashboard: release tracker. Created by
// prisma/sql/2026-10-10_releases_epk_payouts.sql.
model Release {
  id           String    @id @default(uuid())
  user_id      String
  user         User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  title        String
  status       String    @default("draft") // "live" | "soon" | "draft"
  distributor  String?
  release_date DateTime? @db.Date
  created_at   DateTime  @default(now())

  @@map("releases")
  @@index([user_id])
}

// Artist dashboard: manual royalty/income log. No distributor API; the
// artist types each payment in.
model Payout {
  id          String   @id @default(uuid())
  user_id     String
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  distributor String
  amount      Decimal  @db.Decimal(12, 2)
  currency    String   @default("GHS")
  period      String // free text, e.g. "September 2026" or "Q3 2026"
  status      String   @default("paid") // "paid" | "pending"
  note        String?
  created_at  DateTime @default(now())

  @@map("payouts")
  @@index([user_id])
}

// Artist dashboard: the public press kit at /epk/[handle]. One per user.
// Droppa-verified stats (clicks, releases, platforms) are computed live;
// everything here is entered by the artist and shown as self-reported.
model EpkProfile {
  user_id         String   @id
  user            User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  handle          String   @unique
  display_name    String?
  bio             String?
  photo_url       String?
  monthly_streams Int?
  booking_contact String? // email (stored as mailto:) or http(s) URL
  press_quotes    Json     @default("[]") // [{ quote, source }]
  // Which sections show on the public page, e.g. { bio: true, clicks: false }.
  visibility      Json     @default("{}")
  published       Boolean  @default(false)
  updated_at      DateTime @default(now()) @updatedAt

  @@map("epk_profiles")
}
