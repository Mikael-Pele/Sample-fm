# Postgres connection string (Neon, Supabase, Railway, RDS, etc.)
DATABASE_URL="postgresql://user:password@host:5432/samplefm?schema=public"

# JWT signing secret for auth cookies
JWT_SECRET="replace-with-a-long-random-string"

# Base URL of the deployed app (used to build SmartLink share URLs)
NEXT_PUBLIC_APP_URL="https://sample.fm"

# Paystack
# 1. In your Paystack dashboard: Settings > API Keys & Webhooks — copy the
#    "Secret Key" here (starts with sk_test_ or sk_live_). This is used
#    server-side ONLY to verify that webhook events genuinely came from
#    Paystack (HMAC signature check) — never expose it in client code.
PAYSTACK_SECRET_KEY="sk_live_or_test_xxxxxxxxxxxxxxxxxxxxx"

# 2. In Paystack dashboard: Payments > Payment Pages — create ONE page per
#    price point below (4 total: 2 regions x monthly/yearly), and paste each
#    page's public URL here. These are what the billing buttons link to —
#    the site always DISPLAYS the price in dollars (African visitors see the
#    Africa price, everyone else sees the Global price — PPP-style regional
#    pricing, the same idea Spotify uses), but the amount you actually
#    CHARGE on each Payment Page must be set in NAIRA, at the exact amounts
#    below — a standard Nigerian Paystack account can't charge in USD unless
#    you've separately requested "international payments" access. Set each
#    Payment Page's currency to NGN and its amount to:
NEXT_PUBLIC_PAYSTACK_URL_AFRICA_MONTHLY="https://paystack.com/pay/sample-fm-africa-monthly"    # ₦8,000   (site shows $5)
NEXT_PUBLIC_PAYSTACK_URL_AFRICA_YEARLY="https://paystack.com/pay/sample-fm-africa-yearly"      # ₦80,000  (site shows $50)
NEXT_PUBLIC_PAYSTACK_URL_GLOBAL_MONTHLY="https://paystack.com/pay/sample-fm-global-monthly"    # ₦40,000  (site shows $24.99)
NEXT_PUBLIC_PAYSTACK_URL_GLOBAL_YEARLY="https://paystack.com/pay/sample-fm-global-yearly"      # ₦400,000 (site shows $249.90)

# 3. In the same dashboard section, set the webhook URL to:
#    https://yourdomain.com/api/paystack-webhook
#    Paystack will call this automatically on successful payment. The
#    webhook matches the CHARGED AMOUNT (in kobo, i.e. NGN x 100) back to
#    one of the 4 prices above (see PLAN_PRICES_NGN in lib/plans.js) — so
#    each Payment Page's NGN amount must exactly match that file, or the
#    webhook won't know what to grant. If you ever change a price, update
#    PLAN_PRICES_NGN AND the matching Payment Page together.

# Dev-only: set to "true" on a NON-production deployment (e.g. a Vercel
# preview) to allow the free "Simulate Paystack Success" testing button.
# Leave unset in production — it is blocked automatically either way.
ALLOW_DEV_UPGRADE="false"

# Supabase Storage (cover art uploads) — Settings > API in your Supabase project
SUPABASE_URL="https://xxxxxxxxxxxxx.supabase.co"
SUPABASE_ANON_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx"

# "Report a problem" emails — delivered privately to CONTACT_EMAIL, never
# shown anywhere on the site. Sent via Gmail SMTP using an App Password
# (NOT your regular Gmail password — regular passwords don't work here):
#   1. Turn on 2-Step Verification on the Gmail account: myaccount.google.com/security
#   2. Create an App Password: myaccount.google.com/apppasswords
#      (choose "Mail" as the app) — copy the 16-character password it gives you.
# If these are left unset, reports still save to the database — they just
# won't also be emailed.
CONTACT_EMAIL="augustechtechnologies@gmail.com"
GMAIL_USER="augustechtechnologies@gmail.com"
GMAIL_APP_PASSWORD="xxxxxxxxxxxxxxxx"
